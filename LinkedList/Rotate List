# Definition for singly-linked list.
# class ListNode:
#     def __init__(self, val=0, next=None):
#         self.val = val
#         self.next = next
class Solution:
    def rotateRight(self, head: Optional[ListNode], k: int) -> Optional[ListNode]:
        if not head or not head.next:
            return head
        
        length = 0
        curr = head

        while curr:
            length = length + 1
            if not curr.next:
                tail = curr
            curr = curr.next
        
        rk = k % length

        if rk == 0:
            return head

        curr = head

        for _ in range(length - rk - 1):
            curr = curr.next

        new_head = curr.next

        tail.next = head

        curr.next = None

        return new_head



