class Solution:
    def isValid(self, s: str) -> bool:

        dictn = {")":"(","]":"[","}":"{"}
        st = []

        for ch in s:
            if ch in dictn:
                if st and st[-1] == dictn[ch]:
                    st.pop()
                else:
                    return False
            else:
                st.append(ch)
        
        return not st


        
