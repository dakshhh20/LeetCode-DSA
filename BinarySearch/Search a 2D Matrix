class Solution:
    def searchMatrix(self, matrix: List[List[int]], target: int) -> bool:

        row = len(matrix)
        col = len(matrix[0])

        top = 0
        bot = row - 1

        # Find the possible row
        while top <= bot:
            m = (top + bot) // 2

            if target > matrix[m][-1]:
                top = m + 1

            elif target < matrix[m][0]:
                bot = m - 1

            else:
                break

        if top > bot:
            return False

        row = (top + bot) // 2

        # Binary search inside the row
        l = 0
        r = col - 1

        while l <= r:
            b = (l + r) // 2

            if target > matrix[row][b]:
                l = b + 1

            elif target < matrix[row][b]:
                r = b - 1

            else:
                return True

        return False
