class Solution:
    def connect(self, root):
        k = root
        while k:
            dummy = Node()
            prev = dummy
            while k:
                if k.left:
                    prev.next = k.left
                    prev = prev.next
                if k.right:
                    prev.next = k.right  
                    prev = prev.next    

                k = k.next

            k = dummy.next
        return root

